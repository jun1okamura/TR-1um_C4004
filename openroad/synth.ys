# Yosys Logic Synthesis Script for C4004 Core (TR-1um v59_4 Standard Cells + SRAM128)
# Usage: yosys -s openroad/synth.ys

read_liberty -lib stdcell/v59_4/tr1um_typ_5v0_25c.lib
read_liberty -lib module/SRAM128/SRAM128.lib
read_verilog rtl/c4004_core.v

synth -top c4004_core -flatten
dfflibmap -liberty stdcell/v59_4/tr1um_typ_5v0_25c.lib
opt_clean -purge
abc -liberty stdcell/v59_4/tr1um_typ_5v0_25c.lib -constr openroad/abc.constr
hilomap -singleton -hicell TIEH Y -locell TIEL Y
opt_clean -purge
insbuf -buf BUF_X1 A Y
opt_clean -purge

stat -liberty stdcell/v59_4/tr1um_typ_5v0_25c.lib -liberty module/SRAM128/SRAM128.lib
write_verilog -noattr -noexpr syn/c4004_core_raw.v
