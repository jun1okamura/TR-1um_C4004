* TB1: Reset, LDM, IAC, DCL/CM_RAM, WRM, RDM, RAL
* Full-Chip Extracted Netlist Verification (OSS_FRAME.extracted)
* Clock Period T_clk = 100.000 ns (f_clk = 10.00 MHz)

.include "models.spice"
.include "OSS_FRAME_extracted_sim.spice"

.option reltol=1e-3 abstol=1e-9 vntol=1e-4 method=trap

* Power Supplies (5.0V)
VVDD VDD 0 5.0
VVSS VSS 0 0.0

* Clock P1: Held Low (0V) during Reset [0, 1.5*T]; first rising edge at t = 1.5*T
VCLK P1 0 PULSE(0 5.0 150.000n 0.500n 0.500n 49.500n 100.000n)

* Reset P7: Active High (5V) for [0, 1.0*T] while CLK=0, deasserted at 1.0*T
* Machine Cycle 0 State A1 begins at rising edge #1 (t = 1.5 * T_clk)
VRST P7 0 PWL(0n 5.0 99.500n 5.0 100.000n 0.0)

* TEST Input Pad P10
VTEST P10 0 PWL(0.000n 0.00 150.000n 0.00 950.000n 0.00 1750.000n 0.00 2550.000n 0.00 3350.000n 0.00 4150.000n 0.00 4950.000n 0.00)

